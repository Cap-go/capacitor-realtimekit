{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "description": "ui stays <1 because ui 1.1+ needs iOS 16; revisit with the Capacitor 9 major",
      "matchManagers": [
        "swift",
        "cocoapods"
      ],
      "matchPackageNames": [
        "cloudflare/realtimekit-ios-ui"
      ],
      "allowedVersions": "<1"
    },
    {
      "description": "core stays <2 because realtimekit-ios-ui 0.5.x pins core 1.x; revisit with the Capacitor 9 major",
      "matchManagers": [
        "swift",
        "cocoapods"
      ],
      "matchPackageNames": [
        "dyte-in/RealtimeKitCoreiOS",
        "dyte-in/realtimekitcoreios",
        "cloudflare/realtimekit-ios-core"
      ],
      "allowedVersions": "<2"
    }
  ]
}
