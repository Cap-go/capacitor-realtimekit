{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "schedule:earlyMondays"
  ],
  "dependencyDashboard": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchPackagePatterns": [
        "^com\\.google\\..*"
      ],
      "matchCurrentVersion": "/^.*-android$/",
      "allowedVersions": "/^.*-android$/"
    },
    {
      "matchPackagePatterns": [
        "^com\\.android\\.tools\\.build\\:gradle$"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "swift"
      ],
      "matchPackagePatterns": [
        "^https://github.com/ionic-team/capacitor-swift-pm\\.git$",
        "^ionic-team/capacitor-swift-pm$",
        "^capacitor-swift-pm$"
      ],
      "allowedVersions": "8.0.0",
      "enabled": false
    },
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchPackageNames": [
        "@capacitor/core"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchPackageNames": [
        "@capacitor/core"
      ],
      "rangeStrategy": "replace",
      "allowedVersions": "/^>=\\d+\\.0\\.0$/"
    },
    {
      "matchPackageNames": [
        "androidx.core:core"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": false
    },
    {
      "description": "ui stays <1 because ui 1.1+ needs iOS 16; revisit with the Capacitor 9 major",
      "matchManagers": [
        "swift",
        "cocoapods"
      ],
      "matchPackageNames": [
        "cloudflare/realtimekit-ios-ui"
      ],
      "allowedVersions": "<1"
    },
    {
      "description": "core stays <2 because realtimekit-ios-ui 0.5.x pins core 1.x; revisit with the Capacitor 9 major",
      "matchManagers": [
        "swift",
        "cocoapods"
      ],
      "matchPackageNames": [
        "dyte-in/RealtimeKitCoreiOS",
        "dyte-in/realtimekitcoreios",
        "cloudflare/realtimekit-ios-core"
      ],
      "allowedVersions": "<2"
    }
  ]
}
